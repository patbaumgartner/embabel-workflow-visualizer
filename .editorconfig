# Java sources are formatted by the Spring Java Format Maven plugin
# (`./mvnw spring-javaformat:apply`); the Java section here only stops an
# editor from fighting it before the plugin runs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.java]
indent_style = tab
indent_size = 4

[*.{yml,yaml,json,md}]
indent_size = 2

[*.xml]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[mvnw.cmd]
end_of_line = crlf
