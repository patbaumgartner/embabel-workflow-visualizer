<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
      Build the starter against Spring Boot 4.1 (minimum supported version).
      Embabel 1.5.x requires Spring Boot 4.x / Spring AI 2.x, so this line of the
      starter is Boot 4 only. Consumers still on Spring Boot 3.5 must stay on the
      0.3.x line of this starter — a single artifact cannot support both
      Boot 3 and Boot 4 (Spring Framework 7 baseline).
    -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath></relativePath>
  </parent>

  <groupId>com.patbaumgartner.embabel</groupId>
  <artifactId>embabel-workflow-visualizer-parent</artifactId>
  <version>1.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>embabel-workflow-visualizer-parent</name>
  <description>Spring Boot starter that visualizes Embabel agent workflows as an actuator endpoint and interactive UI.</description>

  <modules>
    <module>embabel-workflow-visualizer-starter</module>
    <module>embabel-sample-application</module>
  </modules>

  <properties>
    <!--
      Default so that Surefire's @{argLine} still resolves when JaCoCo's
      prepare-agent has not run (for example `mvn surefire:test` on its own).
    -->
    <argLine></argLine>
    <!--
      The Embabel version this starter is validated against. It is a test-scoped
      dependency of the starter and the runtime of the sample application; one
      property keeps the two in step and gives Dependabot a single line to bump.
    -->
    <embabel-agent.version>1.5.1</embabel-agent.version>
    <flatten-maven-plugin.version>1.8.0</flatten-maven-plugin.version>
    <jacoco.version>0.8.15</jacoco.version>
    <java.version>21</java.version>
    <jreleaser.version>1.26.0</jreleaser.version>
    <maven-enforcer.version>3.6.3</maven-enforcer.version>
    <!--
      Fixed timestamp for every archive entry, which makes the published jars
      byte-for-byte reproducible: anyone can rebuild the tag and compare against
      Maven Central. Bump it when cutting a release.
    -->
    <project.build.outputTimestamp>2026-08-14T00:00:00Z</project.build.outputTimestamp>
    <spring-javaformat.version>0.0.48</spring-javaformat.version>
  </properties>

  <build>
    <plugins>
      <!--
        Fail the build on an environment that cannot produce the artifact this
        project promises, rather than on a mysterious compiler or runtime error
        much later. Bans duplicate dependency declarations for the same reason.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer.version}</version>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <phase>validate</phase>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[${java.version},)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9.0,)</version>
                </requireMavenVersion>
                <banDuplicatePomDependencyVersions></banDuplicatePomDependencyVersions>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Attach sources jar to every module so consumers can navigate to library
        source code in their IDE and so that GitHub Packages / Maven Central serve them.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
        Attach javadoc jar for the same reason.
        doclint is on so that a broken tag or a dangling {@link} fails the build
        instead of shipping to Maven Central; `missing` is excluded because this
        is a starter whose package-private plumbing needs no formal @param prose.
        Javadoc failures are treated as errors during the release lifecycle.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <doclint>all,-missing</doclint>
          <source>${java.version}</source>
          <release>${java.version}</release>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
        JReleaser Maven plugin — used locally to stage, sign, and publish
        releases to Maven Central. In CI the jreleaser/release-action@v2
        GitHub Action is used instead, reading jreleaser.yml at the root.
      -->
      <plugin>
        <groupId>org.jreleaser</groupId>
        <artifactId>jreleaser-maven-plugin</artifactId>
        <version>${jreleaser.version}</version>
        <inherited>false</inherited>
      </plugin>

      <!--
        Spring Java Format — enforces a consistent code style across all modules.
        Run `mvn spring-javaformat:apply` to auto-format sources; the bound
        `validate` goal fails the build (and CI) on any formatting violation.
      -->
      <plugin>
        <groupId>io.spring.javaformat</groupId>
        <artifactId>spring-javaformat-maven-plugin</artifactId>
        <version>${spring-javaformat.version}</version>
        <executions>
          <execution>
            <id>checkstyle-validate</id>
            <goals>
              <goal>validate</goal>
            </goals>
            <phase>validate</phase>
          </execution>
        </executions>
      </plugin>

      <!--
        Resolve dependency paths into properties (e.g. ${org.mockito:mockito-core:jar})
        so Surefire can attach Mockito as a proper -javaagent below.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>resolve-dependency-properties</id>
            <goals>
              <goal>properties</goal>
            </goals>
            <phase>process-test-resources</phase>
          </execution>
        </executions>
      </plugin>

      <!--
        Attach Mockito explicitly as a java agent. Without this, Mockito
        self-attaches the Byte Buddy agent at runtime, which the JDK warns about
        ("Dynamic loading of agents will be disallowed by default in a future
        release"). The agent appends to the bootstrap classpath, which makes the
        JVM warn that class-data sharing is unavailable, so CDS is turned off.

        @{argLine} carries JaCoCo's agent through; replacing argLine outright
        would silently disable coverage collection.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
        </configuration>
      </plugin>

      <!--
        Measure test coverage. The report is written to
        target/site/jacoco/index.html for every module; the starter additionally
        enforces a minimum in its own POM.
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <goals>
              <goal>report</goal>
            </goals>
            <phase>test</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <url>https://github.com/patbaumgartner/embabel-workflow-visualizer</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>patbaumgartner</id>
      <name>Patrick Baumgartner</name>
      <url>https://github.com/patbaumgartner</url>
    </developer>
  </developers>

  <!--
    Maven appends a module's artifactId to every inherited SCM path unless told
    not to, which is right for a project whose modules live in a repository each
    and wrong for this one. Left alone, the published starter POM carries a
    browse URL that 404s and a connection URL that does not clone.
  -->
  <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
    <connection>scm:git:https://github.com/patbaumgartner/embabel-workflow-visualizer.git</connection>
    <developerConnection>scm:git:https://github.com/patbaumgartner/embabel-workflow-visualizer.git</developerConnection>
    <url>https://github.com/patbaumgartner/embabel-workflow-visualizer</url>
    <tag>HEAD</tag>
  </scm>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/patbaumgartner/embabel-workflow-visualizer/issues</url>
  </issueManagement>

</project>
