<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.patbaumgartner.embabel</groupId>
    <artifactId>embabel-workflow-visualizer-parent</artifactId>
    <version>1.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>embabel-workflow-visualizer-starter</artifactId>
  <name>embabel-workflow-visualizer-starter</name>
  <description>Spring Boot starter that provides a workflow visualizer UI and API for Embabel agents.</description>

  <!--
      This is a library / starter — it must NOT be packaged as an executable jar.
      Do NOT add the spring-boot-maven-plugin here.
    -->

  <properties>
    <embabel-agent.version>1.5.0</embabel-agent.version>
  </properties>

  <dependencies>
    <!-- Core starter: brings spring-boot-autoconfigure + logging -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>

    <!--
      Web layer for the visualizer UI and REST API.
      Spring Boot 4 renamed spring-boot-starter-web to spring-boot-starter-webmvc;
      the old artifact still resolves but is deprecated.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>

    <!-- Actuator for the embabel endpoint -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!--
          Auto-configure support — optional so it is NOT pulled into the
          consuming application's compile classpath transitively.
        -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- Test dependencies -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      embabel-agent-api is needed ONLY in tests so the SampleEmbabelAgent
      test fixture can use @Agent, @Action, etc. annotations.
    -->
    <dependency>
      <groupId>com.embabel.agent</groupId>
      <artifactId>embabel-agent-api</artifactId>
      <version>${embabel-agent.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Ship the licence inside the jar. Apache License 2.0 section 4(a) requires
        giving every recipient of the work a copy of the licence, and for a
        library the jar is the only artifact most consumers ever receive.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-license</id>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <phase>process-resources</phase>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
              <resources>
                <resource>
                  <directory>${maven.multiModuleProjectDirectory}</directory>
                  <includes>
                    <include>LICENSE</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Generate spring-autoconfigure-metadata.properties so that
        Spring Boot can filter non-matching auto-configurations eagerly
        at startup, improving application start time, and
        spring-configuration-metadata.json so that IDEs offer completion
        and documentation for the embabel.workflow.visualizer.* properties.
    -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-autoconfigure-processor</artifactId>
            </path>
            <path>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-configuration-processor</artifactId>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <!--
        This is the published artifact, so its coverage is enforced rather than
        merely reported. The thresholds sit just below the current numbers (0.95
        line / 0.82 branch) so they act as a ratchet against regressions instead
        of a tax on every change.
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>check-coverage</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.95</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.82</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Flatten the POM before deploying so that the artifact uploaded to
        Maven Central is a clean, profile-free POM (profiles are stripped by
        flattenMode=oss). This ensures no SNAPSHOT dependencies and no
        <repositories> blocks appear in the published POM.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>1.8.0</version>
        <configuration>
          <flattenMode>oss</flattenMode>
          <pomElements>
            <profiles>remove</profiles>
          </pomElements>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <goals>
              <goal>flatten</goal>
            </goals>
            <phase>process-resources</phase>
          </execution>
          <execution>
            <id>flatten.clean</id>
            <goals>
              <goal>clean</goal>
            </goals>
            <phase>clean</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <url>https://github.com/patbaumgartner/embabel-workflow-visualizer</url>

</project>
